    "pages/login/login",
    "pages/device-list/device-list",
    "pages/device-detail/device-detail",
    "pages/device-edit/device-edit",
    "pages/map/map",
    "pages/alarm/alarm",
    "pages/user-manage/user-manage",
    "pages/track/track",
    "pages/index/index",
    "pages/logs/logs"
  ],
  "window": {

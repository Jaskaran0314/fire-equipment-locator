/* pages/device-edit/device-edit.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.label.required::before {
  content: '*';
  color: #ff4444;
  margin-right: 8rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input[disabled] {
  background-color: #f5f5f5;
  color: #999;
}

.picker {
  width: 100%;
}

.picker-value {
  width: 100%;
  height: 88rpx;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.arrow {
  color: #999;
  font-size: 24rpx;
}

.tips {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: -20rpx;
}

.button-group {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx 40rpx;
}

.btn-cancel,
.btn-save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.btn-cancel {
  background: #fff;
  color: #666;
  border: 1px solid #e0e0e0;
}

.btn-save {
  background: #1989fa;
  color: #fff;
  border: none;
}